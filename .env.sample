NODE_ENV=production
SESSION_SECRET=your_session_secret_here

PORT=3000
BOOTSTRAP_INVITE_TOKEN=

WEBHOOK_SECRET=
WEBHOOK_PATH_TOKEN=

# Optional: read-only F-List Postgres via the host SSH tunnel (see
# deploy/README-flist-tunnel.md). Leave unset to disable the F-List status check.
# Host is the pinned compose-network gateway 172.28.0.1 (where the tunnel binds).
# FLIST_DB_URL=postgres://ledger_ro:PASSWORD@172.28.0.1:15432/flist?sslmode=disable
